    "postinstall": "node -e \"const fs=require('fs');const p='node_modules/metro-config/src/loadConfig.js';let c=fs.readFileSync(p,'utf8');c=c.replace(/const configModule = await import\\(absolutePath\\);/g,'const configModule = await import(process.platform === \\\"win32\\\" ? require(\\\"url\\\").pathToFileURL(absolutePath).href : absolutePath);');fs.writeFileSync(p,c);\""
  },
